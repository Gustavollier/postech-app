# =============================================================================
# terraform.tfvars.example — Template de variáveis para ambiente LOCAL
#
# INSTRUÇÕES:
#   1. Copie este arquivo: cp terraform.tfvars.example terraform.tfvars
#   2. Substitua os valores placeholder pelas suas senhas reais
#   3. O arquivo terraform.tfvars está no .gitignore — nunca commite secrets
#
# Para CI/CD: NÃO use este arquivo. Configure GitHub Secrets:
#   TF_VAR_mssql_sa_password, TF_VAR_app_db_password, TF_VAR_jwt_secret_key
# =============================================================================

cluster_name      = "postechallenge"
kustomize_overlay = "local"   # "local" para dev, "ci" para pipeline

# Secrets — troque pelos valores reais (não commite este arquivo com senhas reais)
mssql_sa_password = "TroqueEstaSenha@12345"
app_db_password   = "TroqueEstaSenhaDoApp@12345"
jwt_secret_key    = "troque-esta-chave-por-uma-chave-aleatoria-de-32-bytes"
