    {
      "name": "Autenticação",
      "item": [
        {
          "name": "Login (público)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/Autenticacao/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "Autenticacao",
                "login"
              ]
            },
            "description": "Autentica um funcionário por CPF e senha. O access token retornado é salvo automaticamente na variável de collection {{accessToken}} (script em Tests).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cpf\": \"{{funcionarioCpf}}\",\n  \"senha\": \"{{funcionarioSenha}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    const token = json.accessToken || json.AccessToken;",
                  "    if (token) {",
                  "        pm.collectionVariables.set('accessToken', token);",
                  "        console.log('accessToken salvo na collection.');",
                  "    }",
                  "    const refresh = json.refreshToken || json.RefreshToken;",
                  "    if (refresh) pm.collectionVariables.set('refreshToken', refresh);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Alterar senha",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/Autenticacao/alterar-senha",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "Autenticacao",
                "alterar-senha"
              ]
            },
            "description": "Altera a senha do funcionário autenticado. Requisitos: mínimo 8 caracteres, 1 maiúscula, 1 número e 1 caractere especial.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"senhaAtual\": \"{{funcionarioSenha}}\",\n  \"novaSenha\": \"NovaSenha@456\",\n  \"confirmacaoSenha\": \"NovaSenha@456\"\n}",
              "options": {
