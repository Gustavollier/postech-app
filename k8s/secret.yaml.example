# ATENÇÃO: Este arquivo é apenas um EXEMPLO/TEMPLATE.
# NÃO commitar valores reais de secrets no repositório.
# Os secrets são criados pelo script local-up.sh (local) ou pelo pipeline (CI/CD).
#
# Para gerar os valores base64:
#   echo -n "SuaSenha@123" | base64
#
# Para criar manualmente via kubectl:
#   kubectl create secret generic postechallenge-secrets \
#     --namespace=postechallenge \
#     --from-literal=MSSQL_SA_PASSWORD='SuaSenha@123' \
#     --from-literal=APP_DB_PASSWORD='SuaSenhaApp@123' \
#     --from-literal=Jwt__SecretKey='sua-chave-jwt-com-mais-de-32-bytes' \
#     --from-literal=ConnectionStrings__DefaultConnection='Server=sqlserver,1433;Database=PosTechChallenge;User Id=appchat;Password=SuaSenhaApp@123;TrustServerCertificate=True;'

apiVersion: v1
kind: Secret
metadata:
  name: postechallenge-secrets
  namespace: postechallenge
type: Opaque
data:
  # base64 de valores EXEMPLO — substituir pelos reais
  MSSQL_SA_PASSWORD: <BASE64_MSSQL_SA_PASSWORD>
  APP_DB_PASSWORD: <BASE64_APP_DB_PASSWORD>
  Jwt__SecretKey: <BASE64_JWT_SECRET_KEY>
  ConnectionStrings__DefaultConnection: <BASE64_CONNECTION_STRING>
